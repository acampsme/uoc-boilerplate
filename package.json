{
  "name": "uoc-boilerplate",
  "version": "3.14.0",
  "private": true,
  "description": "Recomanació responsive d'Arrival amb Sass i UOC Boilerplate",
  "scripts": {
    "parcel:serve": "parcel -p 8123 --target web",
    "parcel:build": "parcel build --target web --no-source-maps --no-cache",
    "clean": "rimraf dist .cache .cache-loader .parcel-cache",
    "dev": "npm-run-all clean parcel:serve",
    "build": "npm-run-all clean parcel:build",
    "stylelint": "stylelint \"src/assets/styles/**/*.scss\"",
    "test": "npm run stylelint"
  },
  "targets": {
    "web": {
      "context": "browser",
      "publicUrl": "./",
      "source": "src/index.html",
      "engines": {
        "browsers": "last 2 versions, > 0.5%, not dead"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acampsme/uoc-boilerplate.git"
  },
  "author": {
    "name": "Jordi Tarrida",
    "email": "jorditarrida@uoc.edu"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/acampsme/uoc-boilerplate/issues"
  },
  "homepage": "https://github.com/acampsme/uoc-boilerplate#readme",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "autoprefixer": "^10.5.5",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.16.4",
    "postcss-preset-env": "^11.5.1",
    "posthtml-include": "^2.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.33.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1"
  }
}
